{
  "name": "ai-command-center",
  "version": "1.0.0",
  "private": true,
  "description": "BOR AI — multi-agent AI workspace on Cloudflare Workers",
  "scripts": {
    "start": "npx --yes wrangler@4 dev --config wrangler.jsonc",
    "dev": "npx --yes wrangler@4 dev --config wrangler.jsonc",
    "test": "node --experimental-default-type=module --test",
    "check": "node --check src/index.js",
    "preview": "npx --yes wrangler@4 deploy --dry-run --outdir .wrangler/deploy --config wrangler.jsonc",
    "deploy": "npx --yes wrangler@4 deploy --config wrangler.jsonc",
    "db:migrate": "npx --yes wrangler@4 d1 migrations apply bor-ai-chat --remote --config wrangler.jsonc",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "eval:validate": "node --test tests/model-quality-evaluation.test.js",
    "eval:plan": "node evaluation/prepare-model-evaluation.js",
    "eval:report": "node evaluation/summarize-model-evaluation.js",
    "eval:blind": "node evaluation/create-blinded-review-packets.js",
    "eval:consensus": "node evaluation/score-blinded-reviews.js",
    "eval:decision": "node evaluation/decide-model-advancement.js",
    "eval:unblind": "node evaluation/unblind-model-selection.js"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
