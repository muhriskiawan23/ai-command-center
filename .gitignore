# Dependencies and local tooling
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# Logs and temporary files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Playwright
test-results/
playwright-report/

# Local egress credentials and generated probe configs
.egress-token
.bor-ai-keys/
tools/egress-proxy/runtime/wrangler*.generated.json

# Image activation config is generated from reviewed deployment variables.
wrangler.images.generated.jsonc
# Image-only D1 listing configuration; never deploy or apply as a production migration.
wrangler.image-only-migrations.generated.jsonc
image-credit-grant.sql
wrangler.duitku-sandbox.generated.jsonc

# Dedicated billing staging binding and test origin (operator-generated; never commit).
wrangler.billing-staging.generated.jsonc

# Isolated private chat backup: generated configs stay local to CI/runner.
# The enabled-shaped candidate contains FAKE identifiers only and is never deployed.
wrangler.chat-private-backup.generated.jsonc
wrangler.chat-private-backup.candidate.generated.jsonc
