{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bor-ai-duitku-sandbox",
  "main": "src/duitku-sandbox-worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "SANDBOX_DB",
      "database_name": "bor-ai-duitku-sandbox",
      "database_id": "0744f4c0-7980-4de1-977d-d8bbd51fe395",
      "migrations_dir": "sandbox/duitku/migrations"
    }
  ],
  "vars": {
    "PAYMENT_SANDBOX_ENABLED": "true",
    "DUITKU_SANDBOX_MERCHANT_CODE": "DS38217",
    "SANDBOX_PUBLIC_ORIGIN": "https://bor-ai-duitku-sandbox.muhriskiawan23.workers.dev"
  }
}
