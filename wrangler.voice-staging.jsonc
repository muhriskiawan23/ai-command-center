{
  "name": "bor-ai-voice-staging",
  "main": "staging/bor-voice/phone-worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/phone.html", "**/phone-client.js", "**/voice-live.js"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "VOICE_PILOT", "class_name": "VoicePilot" }]
  },
  "migrations": [{ "tag": "voice-pilot-v1", "new_sqlite_classes": ["VoicePilot"] }],
  "vars": {
    "BOR_VOICE_PAID_ENABLED": "false"
  }
}
