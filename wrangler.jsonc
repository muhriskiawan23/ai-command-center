{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-command-center",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "947231001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bor-ai-chat",
      "database_id": "d71231a9-9a04-471c-b904-d1bc843940aa",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SEARCH_SHARED_BUDGET_ENABLED": "true",
    "URL_READER_ENABLED": "true",
    "SEARCH_PROVIDER": "tavily",
    "SEARCH_DAILY_ATTEMPT_LIMIT_TAVILY": "12",
    "URL_READER_PROVIDER": "tavily",
    "TAVILY_EXTRACT_DAILY_URL_LIMIT": "8",
    "BOR_GPT_OSS_ENABLED": "false",
    "BOR_GPT_OSS_DAILY_USD_LIMIT": "0.25",
    "BROWSER_AGENT_ENABLED": "false",
    "BROWSER_AGENT_ALLOWED_HOSTS": "demo.playwright.dev,example.com",
    "BROWSER_AGENT_DAILY_USER_JOBS": "2",
    "BROWSER_AGENT_DAILY_GLOBAL_JOBS": "10"
  }
}
