{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-command-center",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "947231001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
